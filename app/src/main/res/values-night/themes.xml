<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for night mode. -->
    <style name="Theme.MyApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background colors - dark mode -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorBackgroundFloating">@color/surface_dark</item>
        <!-- Text colors - dark mode -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>
        <!-- Make navigation bar dark in dark mode -->
        <item name="android:navigationBarColor">@color/background_dark</item>
        <!-- Dialog theming -->
        <item name="alertDialogTheme">@style/ThemeOverlay.App.Dialog.Dark</item>
        <!-- Card background color -->
        <item name="cardBackgroundColor">@color/surface_dark</item>
    </style>
    
    <!-- Theme without ActionBar for Chat and Main activities in dark mode -->
    <style name="Theme.MyApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
    </style>
    
    <!-- Dialog theme overlay for dark mode -->
    <style name="ThemeOverlay.App.Dialog.Dark" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
    </style>
</resources>