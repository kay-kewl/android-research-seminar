<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ocean theme for night mode. -->
    <style name="Theme.MyApplication.Ocean" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/ocean_primary</item>
        <item name="colorPrimaryVariant">@color/ocean_primary_variant</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/ocean_secondary</item>
        <item name="colorSecondaryVariant">@color/ocean_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/ocean_background</item>
        <item name="colorSurface">@color/ocean_surface</item>
        <item name="colorError">@color/ocean_error</item>
        <item name="colorOnBackground">@color/ocean_on_background</item>
        <item name="colorOnSurface">@color/ocean_on_surface</item>
        <item name="colorOnError">@color/ocean_on_error</item>
        
        <!-- Component styles -->
        <item name="materialButtonStyle">@style/Widget.MyApp.Button.Ocean</item>
        <item name="materialCardViewStyle">@style/Widget.MyApp.Card.Ocean</item>
    </style>
</resources>