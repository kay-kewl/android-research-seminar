<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
        <!-- Background color. -->
        <item name="android:colorBackground">@color/background</item>
        <!-- Text color -->
        <item name="android:textColor">@color/black</item>
        <!-- Popup menu style for light theme -->
        <item name="popupMenuStyle">@style/PopupMenuStyleLight</item>
        <item name="android:popupMenuStyle">@style/PopupMenuStyleLight</item>
        <!-- Dropdown spinner style for light theme -->
        <item name="android:spinnerDropDownItemStyle">@style/SpinnerDropDownItemStyleLight</item>
    </style>
</resources>