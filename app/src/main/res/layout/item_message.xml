<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- Sent message layout -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSentMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="8dp"
        android:visibility="visible"
        app:cardBackgroundColor="@color/sent_message_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/min_message_width"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Reply preview (if replying to a message) -->
            <LinearLayout
                android:id="@+id/layoutSentReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/reply_background"
                android:padding="6dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvSentReplyAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    tools:text="John Doe" />

                <TextView
                    android:id="@+id/tvSentReplyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Original message that is being replied to" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvSentMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                tools:text="Это отправленное сообщение" />

            <!-- Media attachment (if any) -->
            <ImageView
                android:id="@+id/ivSentMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:minWidth="250dp"
                android:maxHeight="350dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:src="@android:drawable/ic_menu_gallery" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <!-- Edited indicator -->
                <TextView
                    android:id="@+id/tvSentEdited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="изменено"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Timestamp -->
                <TextView
                    android:id="@+id/tvSentTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    tools:text="10:30" />

                <!-- Read indicator -->
                <ImageView
                    android:id="@+id/ivSentRead"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="4dp"
                    android:layout_gravity="center_vertical"
                    app:tint="@color/primary"
                    android:src="@android:drawable/ic_menu_view"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Received message layout -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardReceivedMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="80dp"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/received_message_bg"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardUseCompatPadding="true"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/min_message_width"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Отправитель" />

            <!-- Reply preview (if replying to a message) -->
            <LinearLayout
                android:id="@+id/layoutReceivedReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/reply_background"
                android:padding="6dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvReceivedReplyAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    tools:text="Jane Doe" />

                <TextView
                    android:id="@+id/tvReceivedReplyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Original message that is being replied to" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvReceivedMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                tools:text="Это полученное сообщение" />

            <!-- Media attachment (if any) -->
            <ImageView
                android:id="@+id/ivReceivedMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:minWidth="250dp"
                android:maxHeight="350dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:src="@android:drawable/ic_menu_gallery" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <!-- Edited indicator -->
                <TextView
                    android:id="@+id/tvReceivedEdited"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="изменено"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Timestamp -->
                <TextView
                    android:id="@+id/tvReceivedTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    tools:text="10:30" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout> 