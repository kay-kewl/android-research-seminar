<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.FactSettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fact_settings"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_selection"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/multi_category_info"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <CheckBox
                    android:id="@+id/check_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_all"
                    android:padding="8dp"
                    android:textStyle="bold"/>

                <CheckBox
                    android:id="@+id/check_science"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_science"
                    android:padding="8dp"/>

                <CheckBox
                    android:id="@+id/check_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_history"
                    android:padding="8dp"/>

                <CheckBox
                    android:id="@+id/check_animals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_animals"
                    android:padding="8dp"/>
                
                <CheckBox
                    android:id="@+id/check_geography"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_geography"
                    android:padding="8dp"/>
                
                <CheckBox
                    android:id="@+id/check_physics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_physics"
                    android:padding="8dp"/>
                
                <CheckBox
                    android:id="@+id/check_astronomy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_astronomy"
                    android:padding="8dp"/>
                
                <CheckBox
                    android:id="@+id/check_economics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_economics"
                    android:padding="8dp"/>
                
                <CheckBox
                    android:id="@+id/check_linguistics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_linguistics"
                    android:padding="8dp"/>
                
                <CheckBox
                    android:id="@+id/check_music"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_music"
                    android:padding="8dp"/>
                
                <CheckBox
                    android:id="@+id/check_literature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category_literature"
                    android:padding="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_frequency"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/update_frequency_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radio_on_tap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/update_on_tap"
                        android:padding="8dp"/>

                    <RadioButton
                        android:id="@+id/radio_daily"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/update_daily"
                        android:padding="8dp"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_settings"
            android:padding="12dp"/>
    </LinearLayout>
</ScrollView> 